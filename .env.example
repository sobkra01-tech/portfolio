# Required — Resend API key, server-side only. Get one at https://resend.com
RESEND_API_KEY=

# Optional — sender address. Must be from a domain verified in Resend.
# Defaults to Resend's sandbox sender (onboarding@resend.dev) if unset.
CONTACT_FROM_EMAIL=

# Optional — recipient override. Defaults to profile.email (data/profile.ts) if unset.
CONTACT_EMAIL=
